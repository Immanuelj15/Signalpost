# ==============================================================================
# Signalpost: Evidence-First Norwegian Company Intelligence Agent
# Environment Configuration
# ==============================================================================

# Database path (defaults to SQLite in data directory)
DATABASE_PATH=data/signalpost.db

# User Agent for public HTTP requests (Required by open government APIs)
USER_AGENT=Signalpost-Research-Agent/1.0 (+https://github.com/build-signalpost; research@signalpost.internal)

# Network & Timeout Configuration
REQUEST_TIMEOUT_SECONDS=15
MAX_RETRIES=3
BACKOFF_FACTOR=1.5

# Challenge Operational Limits & Budgets
MAX_OUTBOUND_REQUESTS=2000
MAX_EXTERNAL_API_COST_USD=10.0
EXECUTION_TIMEOUT_MINUTES=45

# Data source toggles (Free official registry and financial records enabled by default)
ENABLE_BRREG_REGISTRY=true
ENABLE_BRREG_FINANCIAL=true
ENABLE_WEBSITE_DISCOVERY=true

# Optional AI Enhancement (Defaults to false / $0 cost)
# Signalpost operates at 100% functionality with ₹0 / $0 without LLMs.
# Set ENABLE_OPTIONAL_LLM=true only if you configure a local or hosted LLM.
ENABLE_OPTIONAL_LLM=false
OPTIONAL_LLM_PROVIDER=none
OPTIONAL_LLM_API_KEY=
OPTIONAL_LLM_MODEL=

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
